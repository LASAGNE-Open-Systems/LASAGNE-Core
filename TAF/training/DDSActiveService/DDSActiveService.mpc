project(ODDS_DDSActiveService) : ODDSActiveService, odds_pubsub {
  requires += opendds

  TypeSupport_Files {
    LTMTopicDetails.idl
  } 
}

project(NDDS_DDSActiveService) : NDDSActiveService, ndds_pubsub {
  requires += ndds
  after    += ODDS_DDSActiveService

  NDDSTypeSupport_Files {
    LTMTopicDetails.idl
  }
}

project(CDDS_DDSActiveService) : CDDSActiveService, cdds_pubsub {
  requires += coredx
  after    += ODDS_DDSActiveService NDDS_DDSActiveService

  CoreDXTypeSupport_Files {
    LTMTopicDetails.idl
  }
}

project(OSPL_DDSActiveService) : OSPLActiveService, ospl_pubsub {
  requires += opensplice
  after    += ODDS_DDSActiveService NDDS_DDSActiveService CDDS_DDSActiveService

  OSPLTypeSupport_Files {
    LTMTopicDetails.idl
  }
}
